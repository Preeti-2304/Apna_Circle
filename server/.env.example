# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/apnacircle

# JWT Secret & Expiry
JWT_SECRET=apnacircle_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# OTP Configuration
# Set to 'true' to log OTP in server console for easy testing without SMTP
DEV_OTP_CONSOLE=true

# Optional SMTP Settings (for production email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="ApnaCircle <noreply@apnacircle.local>"

# Cloudinary (Optional, profile image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
